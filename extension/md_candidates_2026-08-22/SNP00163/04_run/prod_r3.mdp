; replicate 3 of 3: 100 ns, unrestrained
integrator              = md
dt                      = 0.002
nsteps                  = 25000000   ; 50 ns (ADR-AIIM-331; md_09 writes 100 ns)
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
DispCorr                = EnerPres
constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-iter              = 1
lincs-order             = 4
pbc                     = xyz
tcoupl                  = V-rescale
tc-grps                 = Solute Membrane Solvent
tau-t                   = 1.0 1.0 1.0
ref-t                   = 310 310 310
nstlog                  = 5000
nstenergy               = 5000
nstxout-compressed      = 25000    ; 50 ps/frame
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau-p                   = 5.0
ref-p                   = 1.0 1.0
compressibility         = 4.5e-5 4.5e-5
gen-vel                 = yes
gen-temp                = 310
gen-seed                = 20260824
